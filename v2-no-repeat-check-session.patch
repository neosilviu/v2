+export function setAuthenticatedSessionHint(authenticated: boolean) {
+  try {
+    if (authenticated) window.sessionStorage.setItem(authenticatedSessionHintKey, "1");
+    else window.sessionStorage.removeItem(authenticatedSessionHintKey);
+  } catch {
+    // Storage may be unavailable in restrictive browser modes; session validation remains server-side.
+  }
+}
 
