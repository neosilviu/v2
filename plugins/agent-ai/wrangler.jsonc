{
  "name": "v2-plugin-agent-ai",
  "main": "server/worker.ts",
  "compatibility_date": "2026-05-25",
  "d1_databases": [
    { "binding": "AGENT_DB", "database_name": "v2-agent-ai", "database_id": "6f780fd3-2410-49b7-a4ec-90b5e5e8e0b1" }
  ],
  "services": [
    { "binding": "AUTH", "service": "v2-auth-worker" },
    { "binding": "CORE", "service": "v2-core-worker" },
    { "binding": "PROVIDER_RUNTIME", "service": "v2-plugin-ai-providers" }
  ],
  "vars": { "APP_ORIGIN": "http://localhost:5173", "TRUSTED_ORIGINS": "" }
}
